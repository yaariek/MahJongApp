# Normalise all text files to LF in the repo and on checkout, on every OS.
# Keeps diffs clean and matches Prettier's default `endOfLine: lf`.
* text=auto eol=lf

# Generated / lockfiles — text, but never hand-edited
package-lock.json -diff linguist-generated

# Binary assets — never normalise or diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
*.mov   binary
*.keystore binary
*.jks   binary
