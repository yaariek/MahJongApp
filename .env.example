# Copy to `.env.local` and fill in real values. `.env` / `.env*.local` are git-ignored.
#
# EXPO_PUBLIC_* variables are inlined into the app bundle and are readable by anyone
# who downloads the app — never put secrets here. Reference them as
# `process.env.EXPO_PUBLIC_NAME` (dot notation only).
#
# Real secrets (e.g. the VLM API key, Supabase service-role key) belong on the server
# proxy's own environment, never in this app.

# Phase 2 — URL of the serverless VLM proxy (not the vision-model API key itself)
EXPO_PUBLIC_SCORING_API_URL=

# Phase 4 — Supabase project URL + anon (public) key; protect data with Row Level Security
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
